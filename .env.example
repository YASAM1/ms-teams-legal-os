NODE_ENV=development

# Postgres (provisioned by Vercel Marketplace → Neon)
DATABASE_URL=postgres://...

# Azure Bot / Teams (from Azure Bot resource registration)
BOT_APP_ID=
BOT_APP_PASSWORD=
BOT_APP_TYPE=SingleTenant
BOT_APP_TENANT_ID=

# Entra ID app (delegated Graph access + Auth.js admin SSO)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Redirect URI registered on the Entra app for the Outlook (Graph) connect flow.
# Must exactly match a redirect URI on the app registration.
GRAPH_REDIRECT_URI=https://your-domain.vercel.app/api/graph/oauth/callback

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Comma-separated list of emails allowed to access /admin
ADMIN_EMAIL_ALLOWLIST=

# Clio Manage OAuth app
CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=
CLIO_REDIRECT_URI=https://your-domain.vercel.app/api/clio/oauth/callback
# Shared secret for HMAC-SHA256 verification of inbound Clio webhooks
CLIO_WEBHOOK_SECRET=

# Bearer token used to authorize Vercel Cron calls. Generate with: openssl rand -hex 32
CRON_SECRET=

# 32+ char hex string used as the master key for envelope encryption of stored tokens
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Vercel AI Gateway
AI_GATEWAY_API_KEY=

# Langfuse (AI tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
